{
  "name": "falcon",
  "about": "A fast Dart linter",
  "version": "0.4.6",
  "usage": "falcon [OPTIONS] <COMMAND>",
  "globalArgs": [
    {
      "name": "log_format",
      "long": "--log-format",
      "short": null,
      "valueName": "FORMAT",
      "default": "text",
      "help": "Log output format",
      "possibleValues": [
        "text",
        "json"
      ],
      "positional": false
    },
    {
      "name": "verbose",
      "long": "--verbose",
      "short": null,
      "valueName": null,
      "default": "false",
      "help": null,
      "possibleValues": [],
      "positional": false
    }
  ],
  "subcommands": [
    {
      "name": "check",
      "about": "Lint one or more Dart files or directories",
      "usage": "falcon check [OPTIONS] [PATHS]...",
      "args": [
        {
          "name": "paths",
          "long": null,
          "short": null,
          "valueName": "PATHS",
          "default": null,
          "help": "Paths to lint (defaults to the current directory)",
          "possibleValues": [],
          "positional": true
        },
        {
          "name": "config",
          "long": "--config",
          "short": null,
          "valueName": "CONFIG",
          "default": null,
          "help": "Path to falcon.json config",
          "possibleValues": [],
          "positional": false
        },
        {
          "name": "format",
          "long": "--format",
          "short": null,
          "valueName": "FORMAT",
          "default": "text",
          "help": "Output format for diagnostics",
          "possibleValues": [
            "text",
            "json",
            "sarif",
            "gitlab",
            "checkstyle",
            "sonar",
            "html"
          ],
          "positional": false
        },
        {
          "name": "write",
          "long": "--write",
          "short": null,
          "valueName": null,
          "default": "false",
          "help": "Apply safe fixes to selected Dart files",
          "possibleValues": [],
          "positional": false
        },
        {
          "name": "unsafe_fixes",
          "long": "--unsafe",
          "short": null,
          "valueName": null,
          "default": "false",
          "help": "Also apply fixes classified as unsafe (requires --write)",
          "possibleValues": [],
          "positional": false
        },
        {
          "name": "dry_run",
          "long": "--dry-run",
          "short": null,
          "valueName": null,
          "default": "false",
          "help": "Preview fixes as a unified diff without modifying files (requires --write)",
          "possibleValues": [],
          "positional": false
        },
        {
          "name": "exclude",
          "long": "--exclude",
          "short": null,
          "valueName": "GLOB",
          "default": null,
          "help": "Config-relative glob patterns to exclude (repeatable)",
          "possibleValues": [],
          "positional": false
        },
        {
          "name": "max_errors",
          "long": "--max-errors",
          "short": null,
          "valueName": "N",
          "default": null,
          "help": "Limit the number of printed diagnostics without changing the exit status",
          "possibleValues": [],
          "positional": false
        },
        {
          "name": "error_on_warnings",
          "long": "--error-on-warnings",
          "short": null,
          "valueName": null,
          "default": "false",
          "help": "Fail on warnings as well as errors",
          "possibleValues": [],
          "positional": false
        },
        {
          "name": "baseline",
          "long": "--baseline",
          "short": null,
          "valueName": "PATH",
          "default": null,
          "help": "Suppress existing findings recorded in this baseline",
          "possibleValues": [],
          "positional": false
        },
        {
          "name": "write_baseline",
          "long": "--write-baseline",
          "short": null,
          "valueName": "PATH",
          "default": null,
          "help": "Record current findings (defaults to the configured baseline or project-root falcon-baseline.json)",
          "possibleValues": [],
          "positional": false
        },
        {
          "name": "quiet",
          "long": "--quiet",
          "short": null,
          "valueName": null,
          "default": "false",
          "help": "Suppress all diagnostic output",
          "possibleValues": [],
          "positional": false
        },
        {
          "name": "no_errors_on_unmatched",
          "long": "--no-errors-on-unmatched",
          "short": null,
          "valueName": null,
          "default": "false",
          "help": "Do not report missing paths or runs that process no files",
          "possibleValues": [],
          "positional": false
        },
        {
          "name": "exit_code",
          "long": "--exit-code",
          "short": null,
          "valueName": "N",
          "default": "1",
          "help": "Exit code to use when violations are found (default: 1)",
          "possibleValues": [],
          "positional": false
        }
      ]
    },
    {
      "name": "lsp",
      "about": "Start the LSP server (reads JSON-RPC 2.0 from stdin)",
      "usage": "falcon lsp [OPTIONS]",
      "args": []
    },
    {
      "name": "migrate",
      "about": "Migrate to falcon.json. Converts a `dart_code_linter` / `pyramid_lint` `analysis_options.yaml`, or upgrades an existing falcon.json by rewriting legacy rule ids to their canonical form (auto-detected from the input)",
      "usage": "falcon migrate [OPTIONS]",
      "args": [
        {
          "name": "input",
          "long": "--input",
          "short": null,
          "valueName": "PATH",
          "default": null,
          "help": "Path to the input: an `analysis_options.yaml` to convert, or an existing falcon.json to upgrade (default: ./`analysis_options.yaml`)",
          "possibleValues": [],
          "positional": false
        },
        {
          "name": "write",
          "long": "--write",
          "short": null,
          "valueName": null,
          "default": "false",
          "help": "Write falcon.json instead of printing to stdout",
          "possibleValues": [],
          "positional": false
        },
        {
          "name": "output",
          "long": "--output",
          "short": null,
          "valueName": "PATH",
          "default": null,
          "help": "Output path when --write is set (default: ./falcon.json)",
          "possibleValues": [],
          "positional": false
        }
      ]
    },
    {
      "name": "version",
      "about": "Print version information and exit",
      "usage": "falcon version [OPTIONS]",
      "args": []
    }
  ]
}
