        "unnecessary-nullable": "warn",
        "unused-code": "warn",
        "unused-files": "warn",
        "depend-on-referenced-packages": "off",
        "sort-pub-dependencies": "off",
        "unused-dependencies": "warn",
        "undeclared-dependencies": "warn",
        "no-import-cycles": "warn",
        "banned-imports": "warn"
      },
      "security": {
        "secure-pubspec-urls": "off"
      },
      "style": {
        "package-names": "off"
      }
    }
  },
  "max-errors": null
}
