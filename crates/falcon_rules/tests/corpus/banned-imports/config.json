{
  "cross-file": {
    "rules": {
      "correctness": {
        "banned-imports": {
          "level": "warn",
          "options": {
            "rules": [
              {
                "files": ["lib/domain/**"],
                "deny": ["dart:io", "package:flutter/**", "lib/data/**", "package:legacy/*.dart"],
                "message": "Keep domain code independent of platform and data libraries."
              }
            ]
          }
        }
      }
    }
  }
}
