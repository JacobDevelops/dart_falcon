{
  "linter": {
    "rules": {
      "suspicious": {
        "avoid-referencing-subclasses": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/good_options.dart", "**/bad_options.dart"],
      "linter": {
        "rules": {
          "suspicious": {
            "avoid-referencing-subclasses": {
              "level": "warn",
              "options": {
                "ignored-annotations": ["generated"]
              }
            }
          }
        }
      }
    }
  ]
}
