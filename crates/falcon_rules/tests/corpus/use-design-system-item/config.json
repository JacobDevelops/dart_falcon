{
  "linter": {
    "rules": {
      "style": {
        "use-design-system-item": {
          "level": "warn",
          "options": {
            "items": [
              { "class-name": "Container", "use-instead": "AppContainer" },
              { "class-name": "Text", "use-instead": "AppText" },
              { "class-name": "ElevatedButton", "use-instead": "AppButton" },
              { "class-name": "Scaffold", "use-instead": "AppScaffold" }
            ]
          }
        }
      }
    }
  }
}
