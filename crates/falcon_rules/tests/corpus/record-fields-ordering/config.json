{
  "linter": {
    "rules": {
      "style": {
        "record-fields-ordering": {
          "level": "warn",
          "options": {
            "order": "ascending"
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/bad_2.dart",
        "**/good_2.dart"
      ],
      "linter": {
        "rules": {
          "style": {
            "record-fields-ordering": {
              "level": "warn",
              "options": {
                "order": "descending"
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/good_3.dart",
        "**/good_4.dart"
      ],
      "linter": {
        "rules": {
          "style": {
            "record-fields-ordering": {
              "level": "warn",
              "options": {}
            }
          }
        }
      }
    }
  ]
}
